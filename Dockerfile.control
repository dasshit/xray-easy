FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY third_party ./third_party
RUN for attempt in 1 2 3 4 5; do go mod download && exit 0; sleep 5; done; exit 1
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags='-s -w' -o /out/xray-easy ./cmd/xray-easy

FROM golang:1.24-alpine AS mkcert-build
RUN GOBIN=/out go install filippo.io/mkcert@v1.4.4

FROM node:24-alpine AS web-build
WORKDIR /web
COPY web/package.json ./
COPY web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web ./
RUN npm run build

FROM alpine:3.22
RUN addgroup -S -g 10001 xray && adduser -S -D -H -u 10001 -G xray xray \
    && apk add --no-cache ca-certificates
COPY --from=build /out/xray-easy /usr/local/bin/xray-easy
COPY --from=mkcert-build /out/mkcert /usr/local/bin/mkcert
COPY --from=web-build /web/dist /usr/share/xray-easy/ui
RUN mkdir -p /data /etc/xray \
    && chown -R xray:xray /data /etc/xray /usr/local/bin/xray-easy
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/xray-easy"]
