# syntax=docker/dockerfile:1

FROM --platform=$BUILDPLATFORM golang:1.27.1-alpine AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
COPY awg-contract/go.mod ./awg-contract/go.mod
COPY third_party/go-qrcode/go.mod ./third_party/go-qrcode/go.mod
RUN --mount=type=cache,target=/go/pkg/mod \
    for attempt in 1 2 3 4 5; do go mod download && exit 0; sleep 5; done; exit 1
COPY cmd ./cmd
COPY internal ./internal
COPY awg-contract ./awg-contract
COPY third_party ./third_party
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} go build -mod=readonly -trimpath -ldflags='-s -w' -o /out/xray-easy ./cmd/xray-easy

FROM --platform=$BUILDPLATFORM golang:1.27.1-alpine AS mkcert-build
ARG TARGETOS
ARG TARGETARCH
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} go install filippo.io/mkcert@v1.4.4 \
    && mkdir -p /out \
    && if [ -x "/go/bin/${TARGETOS}_${TARGETARCH}/mkcert" ]; then \
        cp "/go/bin/${TARGETOS}_${TARGETARCH}/mkcert" /out/mkcert; \
    else \
        cp /go/bin/mkcert /out/mkcert; \
    fi

FROM --platform=$BUILDPLATFORM node:24-alpine AS web-build
WORKDIR /web
COPY web/package.json ./
COPY web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web ./
RUN npm run build

FROM alpine:3.22
RUN addgroup -S -g 10001 xray && adduser -S -D -H -u 10001 -G xray xray \
    && apk add --no-cache ca-certificates
COPY --from=build /out/xray-easy /usr/local/bin/xray-easy
COPY --from=mkcert-build /out/mkcert /usr/local/bin/mkcert
COPY --from=web-build /web/dist /usr/share/xray-easy/ui
COPY LICENSE /usr/share/licenses/xray-easy/LICENSE
COPY THIRD_PARTY_NOTICES.md /usr/share/licenses/xray-easy/THIRD_PARTY_NOTICES.md
COPY third_party/licenses/ /usr/share/licenses/xray-easy/third_party/licenses/
COPY third_party/go-qrcode/LICENSE /usr/share/licenses/xray-easy/third_party/go-qrcode/LICENSE
RUN mkdir -p /data /etc/xray \
    && chown -R xray:xray /data /etc/xray /usr/local/bin/xray-easy
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/xray-easy"]
