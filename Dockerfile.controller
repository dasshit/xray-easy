FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY awg-contract ./awg-contract
COPY third_party ./third_party
RUN for attempt in 1 2 3 4 5; do go mod download && exit 0; sleep 5; done; exit 1
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags='-s -w' -o /out/xray-controller ./cmd/xray-controller

FROM alpine:3.22
RUN addgroup -S -g 10001 xray && adduser -S -D -H -u 10001 -G xray xray \
    && apk add --no-cache ca-certificates
COPY --from=build /out/xray-controller /usr/local/bin/xray-controller
USER 10001:10001
EXPOSE 10088
ENTRYPOINT ["/usr/local/bin/xray-controller"]
