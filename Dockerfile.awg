FROM golang:1.25-alpine AS build
WORKDIR /src
COPY awg-service/go.mod awg-service/go.sum ./
RUN go mod download
COPY awg-service ./
ARG TARGETOS
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath -ldflags='-s -w' -o /out/awg-service ./cmd/awg-service

FROM alpine:3.22
RUN addgroup -S -g 10001 xray-easy \
    && apk add --no-cache ca-certificates iproute2 iptables \
    && mkdir -p /data \
    && chown 10001:10001 /data \
    && chmod 0750 /data
COPY --from=build /out/awg-service /usr/local/bin/awg-service
COPY THIRD_PARTY_NOTICES.md /usr/share/licenses/xray-easy/THIRD_PARTY_NOTICES.md
COPY third_party/licenses/AMNEZIAWG-GO-MIT-LICENSE /usr/share/licenses/xray-easy/AMNEZIAWG-GO-MIT-LICENSE
USER 10001:10001
EXPOSE 51820/udp
ENTRYPOINT ["/usr/local/bin/awg-service"]
