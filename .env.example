# Example for manual installation. Compose creates private service tokens in
# named volumes. Keep the master key for the lifetime of /data.
XRAY_EASY_PROJECT_NAME=xray-easy
# GHCR owner and release tag. Each service is published as a separate package.
XRAY_EASY_IMAGE_NAMESPACE=dasshit
XRAY_EASY_IMAGE_TAG=latest
XRAY_VERSION=26.7.28
XRAY_PUBLIC_PORT=443
XRAY_VMESS_PORT=9443
XRAY_SHADOWSOCKS_PORT=8388
XRAY_SHADOWSOCKS_ENABLED=false
XRAY_SHADOWSOCKS_METHOD=chacha20-poly1305
XRAY_SHADOWSOCKS_NETWORK=tcp,udp
XRAY_EASY_UI_PORT=8080
# Optional Hysteria 2 inbound on UDP at XRAY_PUBLIC_PORT.
XRAY_HYSTERIA2_ENABLED=false
# self-signed: mkcert creates an untrusted certificate for CERT_IP, and exported
# client links include insecure=1. custom: provide fullchain.pem and privkey.pem
# under secrets/hysteria; exported links keep TLS verification enabled.
XRAY_HYSTERIA2_TLS_MODE=custom
XRAY_HYSTERIA2_CERT_IP=
# Optional with custom mode when connecting to the VPS IP but the certificate
# covers a DNS name. If blank, the Web UI public host is used as SNI.
XRAY_HYSTERIA2_TLS_SERVER_NAME=
# Generate with: openssl rand -base64 32
XRAY_EASY_MASTER_KEY=

# Optional AmneziaWG service. The installer manages COMPOSE_PROFILES and
# AWG_PUBLIC_HOST; enable it there or set COMPOSE_PROFILES=awg manually.
# The public host must match the IP/DNS endpoint used by clients.
# The AWG server private key and obfuscation key use XRAY_EASY_MASTER_KEY.
COMPOSE_PROFILES=
AWG_PUBLIC_HOST=
AWG_PUBLIC_PORT=1234
AWG_LISTEN_PORT=51820
# Change these only when the default ranges overlap existing VDS networks.
# AWG_IPV4_POOL=10.88.0.0/24
# AWG_IPV6_POOL=fd88:88:88::/64
# AWG_DNS_SERVERS=1.1.1.1,2606:4700:4700::1111
# AWG_INTERFACE=awg0
# The built-in AmneziaWG 3.x preset matches the current official client defaults.
# Uncomment only to override. Existing client profiles must use the same values.
# AWG_JC=4
# AWG_JMIN=10
# AWG_JMAX=50
# AWG_S1=12
# AWG_S2=12
# AWG_S3=12
# AWG_S4=12
# AWG_H1=1
# AWG_H2=2
# AWG_H3=3
# AWG_H4=4
# AWG_I1=<custom initiation payload>
# AWG_I2=<custom initiation payload>
# AWG_I3=<custom initiation payload>
# AWG_I4=<custom initiation payload>
# AWG_I5=<custom initiation payload>
# AWG_HEADER_PROTECTION_KEY=<base64-encoded 32-byte key>
# AWG_CONTENT_PADDING_ADDITION=10-100
# AWG_REKEY_AFTER_TIME=100-120
# AWG_REKEY_TIMEOUT=3-7
# AWG_REJECT_AFTER_TIME=150-180
# AWG_KEEPALIVE_TIMEOUT=5-15
# AWG_MAX_HANDSHAKE_ATTEMPTS=15-20
# AWG_RANDOM_TRAILERS=on
# AWG_DISABLE_COOKIES=on
